{
  "name": "vextrus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "test": "vitest run --no-cache",
    "verify": "node scripts/verify.mjs",
    "checkup": "node scripts/checkup.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:drift": "node scripts/db-drift.mjs",
    "test:db": "vitest run --config vitest.db.config.ts",
    "e2e": "node scripts/e2e.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/rule-tester": "8.67.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "jiti": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
