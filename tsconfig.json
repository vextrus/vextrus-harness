{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "incremental": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "*.ts",
    "*.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-verify/build-373/types/**/*.ts",
    ".next-verify/build-373/dev/types/**/*.ts",
    ".next-verify/build-911/types/**/*.ts",
    ".next-verify/build-911/dev/types/**/*.ts",
    ".next-verify/build-1004/types/**/*.ts",
    ".next-verify/build-1004/dev/types/**/*.ts",
    ".next-verify/build-1016/types/**/*.ts",
    ".next-verify/build-1016/dev/types/**/*.ts",
    ".next-verify/build-1109/types/**/*.ts",
    ".next-verify/build-1109/dev/types/**/*.ts",
    ".next-verify/build-1504/types/**/*.ts",
    ".next-verify/build-1504/dev/types/**/*.ts",
    ".next-verify/build-1018/types/**/*.ts",
    ".next-verify/build-1018/dev/types/**/*.ts",
    ".next-verify/build-1111/types/**/*.ts",
    ".next-verify/build-1111/dev/types/**/*.ts",
    ".next-verify/build-1506/types/**/*.ts",
    ".next-verify/build-1506/dev/types/**/*.ts",
    ".next-verify/build-1096/types/**/*.ts",
    ".next-verify/build-1096/dev/types/**/*.ts",
    ".next-verify/build-1189/types/**/*.ts",
    ".next-verify/build-1189/dev/types/**/*.ts",
    ".next-verify/build-1584/types/**/*.ts",
    ".next-verify/build-1584/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
